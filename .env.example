# 复制前请先阅读 docs/development.md。占位值不能启动应用。
A4J_ENVIRONMENT=development
A4J_DATABASE_URL=postgresql+psycopg://assistant:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:15432/assistant
A4J_SESSION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
A4J_ERP_BASE_URL=http://127.0.0.1:18081/jshERP-boot
A4J_PUBLIC_ORIGIN=http://127.0.0.1:18081
A4J_CONNECTION_ID=jsh-bundled-38ad91e
A4J_ERP_CONTRACT=jsh-38ad91e-v1
A4J_ERP_TIMEZONE=Asia/Shanghai
# 真实闭环验收完成前保持关闭。
A4J_PURCHASE_WRITES_ENABLED=false
A4J_RECONCILIATION_DELAYS=[2,5,15,30,60]
A4J_RECONCILIATION_MAX_ROUNDS=3
A4J_DEPENDENCY_TIMEOUT_SECONDS=5
A4J_SESSION_MAX_AGE_SECONDS=28800
A4J_SESSION_IDLE_SECONDS=3600
A4J_EVENT_RETENTION_DAYS=7
A4J_HISTORY_RETENTION_DAYS=30
A4J_AUDIT_RETENTION_DAYS=180
# 仅供本地 Compose 数据库初始化；与 DATABASE_URL 的密码保持一致。
A4J_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# 可选模型连接；三项同时配置才启用对话，采用受控 Chat Completions JSON 协议。
A4J_MODEL_BASE_URL=https://api.example.invalid/v1
A4J_MODEL_NAME=REPLACE_WITH_MODEL_NAME
A4J_MODEL_API_KEY=REPLACE_WITH_MODEL_KEY
A4J_MODEL_TIMEOUT_SECONDS=25
A4J_MODEL_MAX_CALLS=6
A4J_TOOL_MAX_CALLS=12
A4J_DELEGATION_MAX_CALLS=2
A4J_RUN_TIMEOUT_SECONDS=90
A4J_MODEL_MAX_OUTPUT_TOKENS=1800

# scripts/init_stack.py 自动生成，用于内置 ERP 的独立数据库与缓存。
A4J_ERP_DB_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_PASSWORD
A4J_ERP_REDIS_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_PASSWORD
