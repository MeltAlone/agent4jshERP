FROM python:3.14-slim AS host-patch
WORKDIR /build
COPY third_party/jshERP/jshERP-web ./jshERP-web
COPY integrations/jsh-erp/host ./host
RUN python host/install.py apply /build/jshERP-web
FROM node:22-bookworm-slim AS erp-web
ENV NODE_OPTIONS="--openssl-legacy-provider --max-old-space-size=3072"
WORKDIR /web
COPY --from=host-patch /build/jshERP-web/package*.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY --from=host-patch /build/jshERP-web ./
RUN npm run build
FROM node:26-bookworm-slim AS assistant-web
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
COPY integrations/jsh-erp/host /app/integrations/jsh-erp/host
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=erp-web /web/dist /usr/share/nginx/html
COPY --from=assistant-web /app/frontend/dist /usr/share/nginx/html/assistant
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
